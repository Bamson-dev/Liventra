{
  "name": "liventra/liventra",
  "description": "Enterprise-Grade Realtime Webinar & Live Engagement Engine for WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Bamidele Matthew",
      "email": "dev@bamson.dev",
      "homepage": "https://github.com/Bamson-dev"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10",
    "vimeo/psalm": "^5.9",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Liventra\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liventra\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "node tests/run-tests.js",
    "analyse": "phpstan analyse --configuration=phpstan.neon",
    "phpstan": "phpstan analyse --configuration=phpstan.neon",
    "psalm": "psalm --config=psalm.xml",
    "lint": "phpcs --standard=phpcs.xml",
    "cs": "phpcs --standard=phpcs.xml",
    "fix": "phpcbf --standard=phpcs.xml",
    "playwright": "npx playwright test",
    "quality": "composer test",
    "ci": "composer quality"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
